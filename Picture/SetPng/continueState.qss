QToolButton {
    border: 2px solid #E07A7A;
    background-color: transparent;
    color: #E6A817;
    border-radius: 10px;
    width: 80px;
    height: 60px;
    padding: 0px;
    font-family: "楷体", "KaiTi", "SimKai", sans-serif;
    font-size: 22px;
}

QToolButton:hover {
    border: 2px solid #D06060;
    background-color: rgba(224, 122, 122, 30);
    color: #E6A817;
    border-radius: 10px;
    font-family: "楷体", "KaiTi", "SimKai", sans-serif;
    font-size: 22px;
}

QToolButton:pressed {
    border: 2px solid #C04040;
    background-color: rgba(224, 122, 122, 50);
    color: #C99212;
    border-radius: 10px;
    font-family: "楷体", "KaiTi", "SimKai", sans-serif;
    font-size: 22px;
}
