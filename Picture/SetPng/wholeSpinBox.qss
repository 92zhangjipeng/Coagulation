/* QSpinBox 主控件样式 - 医疗浅蓝版（带图像按钮） */
QSpinBox {
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 25px;
    border: 1px solid #AACDE2;
    background-color: #FFFFFF;
    border-radius: 6px;
    selection-color: white;
    selection-background-color: #5FA8D3;
    font-family: '微软雅黑', '楷体', 'KaiTi', sans-serif;
    font-size: 14px;
    color: #1A4D6B;
}

/* 向上按钮样式 */
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    image: url(:/Picture/cssup.png);
    width: 18px;
    height: 16px;
    background: transparent;
    border: none;
}

QSpinBox::up-button:hover {
    background-color: rgba(95, 168, 211, 0.2);
    border-radius: 3px;
}

/* 向下按钮样式 */
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    image: url(:/Picture/cssdown.png);
    width: 18px;
    height: 16px;
    background: transparent;
    border: none;
}

QSpinBox::down-button:hover {
    background-color: rgba(95, 168, 211, 0.2);
    border-radius: 3px;
}

/* 禁用状态 */
QSpinBox:disabled {
    background-color: #E8F0F5;
    border: 1px solid #C8E0F0;
    color: #6A8EAE;
}

/* 聚焦状态 */
QSpinBox:focus {
    border: 2px solid #5FA8D3;
}