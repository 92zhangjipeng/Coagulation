QToolButton {
    border: 1px solid #5FA8D3;
    background-color: #5FA8D3;
    border-style: solid;
    border-radius: 8px;
    width: 130px;
    height: 32px;
    padding: 0 10px;
    font-family: '微软雅黑', '楷体', 'KaiTi', sans-serif;
    font-size: 14px;
    color: white;
}

QToolButton:hover {
    background-color: #3A86A8;
    border: 1px solid #3A86A8;
}

QToolButton:pressed {
    background-color: #2C6D8A;
    border: 1px solid #2C6D8A;
}

QToolButton:disabled {
    background-color: #B0D4E8;
    border: 1px solid #B0D4E8;
    border-style: solid;
    border-radius: 8px;
    width: 130px;
    height: 32px;
    padding: 0 10px;
    font-family: '微软雅黑', '楷体', 'KaiTi', sans-serif;
    font-size: 14px;
    color: #6A8EAE;
}